{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "placebase-proxy",
	"main": "src/worker.ts",
	"compatibility_date": "2025-10-04",
	"observability": { "enabled": true },
	"keep_vars": true,
	"routes": [
		{
			"pattern": "placebase.lionpuro.com/api/*",
			"zone_name": "lionpuro.com"
		},
		{
			"pattern": "placebase.lionpuro.com/__/auth/*",
			"zone_name": "lionpuro.com"
		}
	]
}
