{
	"compilerOptions": {
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"erasableSyntaxOnly": true,
		"resolveJsonModule": true
	}
}
