{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "placebase-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-04",
	"observability": { "enabled": true },
	"vars": { "API_HOST": "api.placebase.xyz" },
	"routes": [
		{
			"pattern": "placebase.xyz/api/internal/*",
			"zone_name": "placebase.xyz"
		}
	]
}
