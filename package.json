{
	"name": "placebase",
	"version": "1.0.0",
	"private": true,
	"types": "./src/index.d.ts",
	"workspaces": [
		"api",
		"web",
		"proxy"
	],
	"scripts": {
		"dev": "concurrently -c yellow,red,magenta -n emu,api,web 'npm run dev:emulators' 'npm run dev:api' 'npm run dev:web'",
		"dev:api": "npm run dev --workspace=api",
		"dev:web": "npm run dev --workspace=web",
		"dev:emulators": "firebase emulators:start",
		"build": "npm run build --workspaces --if-present",
		"build:api": "npm run build --workspace=api",
		"build:web": "npm run build --workspace=web",
		"deploy:proxy": "npm run deploy --workspace=proxy",
		"test": "firebase --config firebase.test.json emulators:exec 'npm run test --workspaces --if-present'",
		"lint": "prettier --check . && npm run lint --workspaces --if-present && tsc --project api/scripts/tsconfig.json --noEmit",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"firebase-tools": "^14.24.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"cookie": "^1.0.2"
	}
}
